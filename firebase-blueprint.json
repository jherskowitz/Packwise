{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "A planned journey with destination coordinates, date range, live weather forecast, activity context, and checklist lifecycle metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the trip owner" },
        "destination": { "type": "string", "description": "City or destination name" },
        "country": { "type": "string", "description": "Country name" },
        "latitude": { "type": "number", "description": "Destination latitude" },
        "longitude": { "type": "number", "description": "Destination longitude" },
        "startDateEpochDay": { "type": "integer", "description": "Start date as UTC epoch day" },
        "endDateEpochDay": { "type": "integer", "description": "End date as UTC epoch day" },
        "durationDays": { "type": "integer", "description": "Trip duration in days" },
        "activities": { "type": "array", "items": { "type": "string" } },
        "calendarEventsSummary": { "type": "array", "items": { "type": "string" } },
        "weatherSummary": { "type": "string" },
        "weatherTempMinC": { "type": "number" },
        "weatherTempMaxC": { "type": "number" },
        "weatherRainProbMax": { "type": "integer" },
        "weatherAlertActive": { "type": "boolean" },
        "weatherAlertMessage": { "type": "string" },
        "weatherNotificationsEnabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "resetCount": { "type": "integer" },
        "travelGuideJson": { "type": "string", "description": "Optional serialized destination attractions, events, and international travel guide" },
        "headerImageUrl": { "type": "string", "description": "Optional destination photo URL for trip card and detail headers" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "destination", "country", "latitude", "longitude",
        "startDateEpochDay", "endDateEpochDay", "durationDays",
        "activities", "calendarEventsSummary", "weatherSummary",
        "weatherTempMinC", "weatherTempMaxC", "weatherRainProbMax",
        "weatherAlertActive", "weatherAlertMessage", "weatherNotificationsEnabled",
        "status", "resetCount", "createdAt", "updatedAt"
      ]
    },
    "PackingItem": {
      "title": "PackingItem",
      "description": "An individual checklist item belonging to a user's trip.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tripId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "integer" },
        "isPacked": { "type": "boolean" },
        "isAlwaysBring": { "type": "boolean" },
        "sourceType": { "type": "string" },
        "contextReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "tripId", "name", "category", "quantity",
        "isPacked", "isAlwaysBring", "sourceType", "contextReason",
        "createdAt", "updatedAt"
      ]
    },
    "AlwaysBringItem": {
      "title": "AlwaysBringItem",
      "description": "A reusable essential stored in the user's Always Bring vault and automatically added to new trips.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "integer" },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "category", "quantity", "notes", "source", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Owner-scoped trips collection"
    },
    "users/{userId}/trips/{tripId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/PackingItem" },
      "description": "Owner-scoped packing items subcollection per trip"
    },
    "users/{userId}/alwaysBring/{itemId}": {
      "schema": { "$ref": "#/entities/AlwaysBringItem" },
      "description": "Owner-scoped timeless Always Bring vault items"
    }
  }
}
