rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\\\].*');
    }

    function isRecentServerTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidTrip(data, userId) {
      return data.keys().hasAll([
          'userId', 'destination', 'country', 'latitude', 'longitude',
          'startDateEpochDay', 'endDateEpochDay', 'durationDays',
          'activities', 'calendarEventsSummary', 'weatherSummary',
          'weatherTempMinC', 'weatherTempMaxC', 'weatherRainProbMax',
          'weatherAlertActive', 'weatherAlertMessage', 'weatherNotificationsEnabled',
          'status', 'resetCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'destination', 'country', 'latitude', 'longitude',
          'startDateEpochDay', 'endDateEpochDay', 'durationDays',
          'activities', 'calendarEventsSummary', 'weatherSummary',
          'weatherTempMinC', 'weatherTempMaxC', 'weatherRainProbMax',
          'weatherAlertActive', 'weatherAlertMessage', 'weatherNotificationsEnabled',
          'status', 'resetCount', 'travelGuideJson', 'headerImageUrl', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 120
        && data.country is string && data.country.size() <= 80
        && (data.latitude is int || data.latitude is float)
        && (data.longitude is int || data.longitude is float)
        && data.startDateEpochDay is int
        && data.endDateEpochDay is int
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 365
        && data.activities is list && data.activities.size() <= 15
        && data.calendarEventsSummary is list && data.calendarEventsSummary.size() <= 25
        && data.weatherSummary is string && data.weatherSummary.size() <= 400
        && (data.weatherTempMinC is int || data.weatherTempMinC is float)
        && (data.weatherTempMaxC is int || data.weatherTempMaxC is float)
        && data.weatherRainProbMax is int && data.weatherRainProbMax >= 0 && data.weatherRainProbMax <= 100
        && data.weatherAlertActive is bool
        && data.weatherAlertMessage is string && data.weatherAlertMessage.size() <= 400
        && data.weatherNotificationsEnabled is bool
        && data.status in ['active', 'completed']
        && data.resetCount is int && data.resetCount >= 0
        && (!('travelGuideJson' in data) || (data.travelGuideJson is string && data.travelGuideJson.size() <= 8000))
        && (!('headerImageUrl' in data) || (data.headerImageUrl is string && data.headerImageUrl.size() <= 1000))
        && isRecentServerTimestamp(data.createdAt)
        && isRecentServerTimestamp(data.updatedAt);
    }

    function isValidPackingItem(data, userId, tripId) {
      return data.keys().hasAll([
          'userId', 'tripId', 'name', 'category', 'quantity',
          'isPacked', 'isAlwaysBring', 'sourceType', 'contextReason',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'tripId', 'name', 'category', 'quantity',
          'isPacked', 'isAlwaysBring', 'sourceType', 'contextReason',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.tripId == tripId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 99
        && data.isPacked is bool
        && data.isAlwaysBring is bool
        && data.sourceType is string && data.sourceType.size() <= 40
        && data.contextReason is string && data.contextReason.size() <= 200
        && isRecentServerTimestamp(data.createdAt)
        && isRecentServerTimestamp(data.updatedAt);
    }

    function isValidAlwaysBringItem(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'category', 'quantity', 'notes', 'source',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'category', 'quantity', 'notes', 'source',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 99
        && data.notes is string && data.notes.size() <= 200
        && data.source is string && data.source.size() <= 40
        && isRecentServerTimestamp(data.createdAt)
        && isRecentServerTimestamp(data.updatedAt);
    }

    match /users/{userId}/trips/{tripId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(tripId)
        && isValidTrip(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidId(tripId)
        && isValidTrip(request.resource.data, userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(tripId);

      match /items/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(tripId)
          && isValidId(itemId)
          && isValidPackingItem(request.resource.data, userId, tripId);
        allow update: if isOwner(userId)
          && isValidId(tripId)
          && isValidId(itemId)
          && isValidPackingItem(request.resource.data, userId, tripId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(tripId) && isValidId(itemId);
      }
    }

    match /users/{userId}/alwaysBring/{itemId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(itemId)
        && isValidAlwaysBringItem(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidId(itemId)
        && isValidAlwaysBringItem(request.resource.data, userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(itemId);
    }
  }
}
